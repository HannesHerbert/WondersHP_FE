# ─── Frontend-Konfiguration ──────────────────────────────────────────────────
# Kopiere diese Datei als .env.development bzw. .env.production.
# Alle VITE_*-Werte landen beim Build im ausgelieferten JavaScript – keine Secrets!

# Nur Entwicklung: Backend-Adresse, an die Vite /api und /media weiterleitet
BACKEND_URL=http://localhost:3001

# Öffentliche Backend-Adresse; leer = gleiche Domain bzw. Vite-Proxy
VITE_API_URL=

VITE_ADMIN_LOGIN_PW=

# Maximale Upload-Größe in MB – sollte zu MAX_UPLOAD_MB im Backend passen (Default: 500)
VITE_MAX_UPLOAD_MB=500
